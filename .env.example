# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://interviewiq:interviewiq@localhost:5432/interviewiq

# ── LLM providers (at least one required for non-test runs) ───────────────────
LLM_PROVIDER=openai           # openai | anthropic | mock
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# ── Prompt versioning ─────────────────────────────────────────────────────────
CONTENT_ENGINE_PROMPT_VERSION=v1
HOLISTIC_ENGINE_PROMPT_VERSION=v1

# ── STT ───────────────────────────────────────────────────────────────────────
WHISPER_MODEL_SIZE=base        # tiny | base | small | medium | large-v3
WHISPER_DEVICE=cpu             # cpu | cuda
WHISPER_COMPUTE_TYPE=int8

# ── Delivery Engine thresholds ────────────────────────────────────────────────
LONG_PAUSE_THRESHOLD_SEC=1.5
FILLER_WORDS=um,uh,like,you know,so,basically,actually,literally

# ── Audit thresholds ─────────────────────────────────────────────────────────
AUDIT_DELIVERY_INVARIANCE_MAX=0.08    # content score delta allowed when only delivery changes
AUDIT_CONTENT_SENSITIVITY_MIN=0.15   # minimum content drop expected after quality degradation
AUDIT_PARAPHRASE_MAX_DEVIATION=0.10  # max score deviation for meaning-preserving paraphrases
AUDIT_REPEATABILITY_MAX_VARIANCE=0.02
AUDIT_STT_MAX_DRIFT=0.08
AUDIT_REPEATED_RUNS=5                # how many times to re-run for consistency test

# ── Ablation ─────────────────────────────────────────────────────────────────
CONTENT_ENGINE_INCLUDE_DELIVERY=false   # ablation: give delivery features to content engine

# ── Experiment tracking ───────────────────────────────────────────────────────
EXPERIMENTS_DIR=experiments

# ── Misc ──────────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
AUDIO_UPLOAD_DIR=uploads
MAX_AUDIO_SIZE_MB=50
