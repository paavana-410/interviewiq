# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://interviewiq:interviewiq@localhost:5432/interviewiq

# ── LLM mode ─────────────────────────────────────────────────────────────────
# Set to "mock" to run without any API keys (tests / CI).
# Remove or set to any other value to activate the judge registry below.
LLM_PROVIDER=mock

# ── Judge configs (add as many as needed: JUDGE_1, JUDGE_2, JUDGE_3, ...) ─────
#
# Each block needs NAME, PROVIDER, API_KEY, MODEL.
# BASE_URL defaults to the standard endpoint for openai / anthropic.
# For openai_compatible (Ollama, Together, etc.) you must set BASE_URL.
# RPM = requests per minute for rate limiting (default 60).

JUDGE_1_NAME=judge_gpt4o
JUDGE_1_PROVIDER=openai
JUDGE_1_BASE_URL=https://api.openai.com/v1
JUDGE_1_API_KEY=sk-replace-me
JUDGE_1_MODEL=gpt-4o
JUDGE_1_RPM=500

JUDGE_2_NAME=judge_claude
JUDGE_2_PROVIDER=anthropic
JUDGE_2_BASE_URL=https://api.anthropic.com/v1
JUDGE_2_API_KEY=sk-ant-replace-me
JUDGE_2_MODEL=claude-3-5-sonnet-20241022
JUDGE_2_RPM=60

JUDGE_3_NAME=judge_local
JUDGE_3_PROVIDER=openai_compatible
JUDGE_3_BASE_URL=http://localhost:11434/v1
JUDGE_3_API_KEY=ollama
JUDGE_3_MODEL=llama3.2:3b
JUDGE_3_RPM=120

# ── Paraphrase model ──────────────────────────────────────────────────────────
# MUST be a different model from every judge above.
# The system will refuse to start if PARAPHRASE_MODEL matches any JUDGE_N_MODEL.

PARAPHRASE_NAME=paraphrase_model
PARAPHRASE_PROVIDER=openai
PARAPHRASE_BASE_URL=https://api.openai.com/v1
PARAPHRASE_API_KEY=sk-replace-me
PARAPHRASE_MODEL=gpt-4o-mini
PARAPHRASE_RPM=500

# ── UI interview judge ────────────────────────────────────────────────────────
# The interview UI uses exactly this judge. Must match one of the JUDGE_N_NAME
# values above. If unset in real mode, the app returns a 503.
UI_JUDGE=judge_ollama

# ── Prompt versioning ─────────────────────────────────────────────────────────
CONTENT_ENGINE_PROMPT_VERSION=v1
HOLISTIC_ENGINE_PROMPT_VERSION=v1

# ── STT ───────────────────────────────────────────────────────────────────────
WHISPER_MODEL_SIZE=base        # tiny | base | small | medium | large-v3
WHISPER_DEVICE=cpu             # cpu | cuda
WHISPER_COMPUTE_TYPE=int8

# ── Delivery Engine ───────────────────────────────────────────────────────────
LONG_PAUSE_THRESHOLD_SEC=1.5
FILLER_WORDS=um,uh,like,you know,so,basically,actually,literally

# ── Audit thresholds ─────────────────────────────────────────────────────────
AUDIT_DELIVERY_INVARIANCE_MAX=0.08
AUDIT_CONTENT_SENSITIVITY_MIN=0.15
AUDIT_PARAPHRASE_MAX_DEVIATION=0.10
AUDIT_REPEATABILITY_MAX_VARIANCE=0.02
AUDIT_STT_MAX_DRIFT=0.08
AUDIT_REPEATED_RUNS=5

# ── Ablation ─────────────────────────────────────────────────────────────────
CONTENT_ENGINE_INCLUDE_DELIVERY=false

# ── Experiment tracking ───────────────────────────────────────────────────────
EXPERIMENTS_DIR=experiments

# ── Misc ──────────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
AUDIO_UPLOAD_DIR=uploads
MAX_AUDIO_SIZE_MB=50
